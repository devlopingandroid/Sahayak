# Use a private file named cloud.env; do not commit it.
SAHAYAK_CLOUD=1
SAHAYAK_DATA=/data
SAHAYAK_ALLOWED_ORIGINS=https://sahayak-memory-assistant.vercel.app
TZ=Asia/Kolkata
PORT=5000
# A migrated SQLite database supplies the caretaker hash, device token,
# session key, Gemini key, Telegram settings and existing enrolled profiles.
# For an empty installation, set these three values privately instead:
# SAHAYAK_PASSWORD_HASH=...
# SAHAYAK_SESSION_KEY=...
# SAHAYAK_DEVICE_TOKEN=...
